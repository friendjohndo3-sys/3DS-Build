; Basic vertex shader for Citro3D
; Constants
.constf myconst(0.0, 1.0, -1.0, 0.5)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outclr color

; Inputs
.alias inpos v0
.alias inclr v1

; Uniforms
.fvec projection[4]
.fvec modelView[4]

.proc main
    ; r1 = modelView * inpos
    dp4 r1.x, modelView[0], inpos
    dp4 r1.y, modelView[1], inpos
    dp4 r1.z, modelView[2], inpos
    dp4 r1.w, modelView[3], inpos

    ; outpos = projection * r1
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    ; outclr = inclr
    mov outclr, inclr
    end
.end
